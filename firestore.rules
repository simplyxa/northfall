rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- помощники ----
    function signed() { return request.auth != null; }
    // логин вошедшего игрока
    function lg() { return request.auth.token.email.split('@')[0]; }
    // логин игрока = часть почты до @northfall.game
    function me(id) { return signed() && request.auth.token.email == id + '@northfall.game'; }
    // ВПИШИ СЮДА логины администраторов (как в ADMINS в index.html)
    function admin() { return signed() && request.auth.token.email in ['shtorm1@northfall.game', 'admin@northfall.game']; }

    // Сохранение героя: только сам игрок (и админ)
    // Защита от накруток: уровень не выше 60 и не прыгает, серебро не растёт скачками
    function saneSave() {
      let n = request.resource.data;
      return n.get('lvl', 1) is int && n.get('lvl', 1) <= 60
        && (resource == null
          || (n.get('lvl', 1) <= resource.data.get('lvl', 1) + 10
              && n.get('gold', 0) <= resource.data.get('gold', 0) + 100000));
    }
    match /saves/{id} {
      allow read: if me(id) || admin();
      allow delete: if me(id) || admin();
      allow create, update: if admin() || (me(id) && saneSave());
    }

    // Кошелёк золота: читает только владелец, меняет только сервер (Netlify)
    match /wallet/{id} {
      allow read: if me(id) || admin();
      allow write: if false;
      match /log/{op} {
        allow read: if me(id) || admin();
        allow write: if false;
      }
    }

    // Почта для восстановления пароля: только сервер (Netlify)
    match /priv/{id} {
      allow read, write: if false;
    }

    // Подписки на уведомления: только сервер (Netlify)
    match /push/{id} {
      allow read, write: if false;
    }

    // Сообщения об ошибках: пишет игрок, читает и удаляет админ
    match /bugs/{bid} {
      allow create: if signed() && request.resource.data.uid == lg()
        && request.resource.data.text is string && request.resource.data.text.size() <= 1000;
      allow read, delete: if admin();
    }

    // Ники для входа: names/{ник в нижнем регистре} → {uid}; читают все (нужно для входа), пишет владелец
    match /names/{n} {
      allow read: if true;
      allow create: if signed() && request.resource.data.uid == lg();
      allow update, delete: if signed() && resource.data.uid == lg() && (request.resource == null || request.resource.data.uid == lg());
    }

    // Публичная карточка игрока: читают все, пишет только владелец
    match /players/{id} {
      allow read: if signed();
      allow write: if me(id) || admin();
    }

    // Подарки, баны, объявления: читают все, пишет только админ
    match /admin/{id} {
      allow read: if signed();
      allow write: if admin();
    }

    // Кланы и всё внутри них (чат, казна, летопись, подземелье)
    match /clans/{clan} {
      allow read, write: if signed();
      match /{sub}/{doc} {
        allow read, write: if signed();
      }
    }

    // Войны, мировой босс, территории, рынок
    match /wars/{id}   { allow read, write: if signed(); }
    match /world/{id}  { allow read, write: if signed(); }
    match /terr/{id}   { allow read, write: if signed(); }
    match /market/{id} { allow read, write: if signed(); }

    // Форум: писать могут все вошедшие, удалять только админ
    match /forum/{topic} {
      allow read, create, update: if signed();
      allow delete: if admin();
      match /posts/{post} {
        allow read, create: if signed();
        allow update, delete: if admin();
      }
    }

    // Покупки за реальные деньги: зачисляет только сервер (Netlify + Xsolla)
    match /pay/{id}/orders/{oid} {
      allow read: if me(id) || admin();
      allow update: if me(id) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['claimed']);
    }
    match /payments/{oid} {
      allow read: if admin();
    }

    // Друзья: документ friends/{a~b}, видят и меняют только двое участников
    match /friends/{pid} {
      allow read: if signed() && (resource == null || lg() == resource.data.a || lg() == resource.data.b);
      allow create: if signed() && request.resource.data.by == lg()
        && (lg() == request.resource.data.a || lg() == request.resource.data.b)
        && pid == request.resource.data.a + '~' + request.resource.data.b
        && request.resource.data.st == 'p';
      allow update: if signed() && (lg() == resource.data.a || lg() == resource.data.b)
        && request.resource.data.a == resource.data.a && request.resource.data.b == resource.data.b
        && request.resource.data.by == resource.data.by
        && (request.resource.data.st == resource.data.st || (resource.data.by != lg() && request.resource.data.st == 'ok'));
      allow delete: if signed() && (lg() == resource.data.a || lg() == resource.data.b);
    }
    // Личные сообщения и письма
    match /dm/{pid}/m/{mid} {
      allow read: if signed() && lg() in pid.split('~');
      // друзьям — бесплатно, остальным — письмо за 10 серебра (списывается в игре)
      allow create: if signed() && lg() in pid.split('~') && request.resource.data.from == lg()
        && request.resource.data.text is string && request.resource.data.text.size() <= 500;
      // получатель забирает вещь из письма: можно поменять только claimed, и только один раз
      allow update: if signed() && lg() in pid.split('~') && lg() != resource.data.from
        && resource.data.get('claimed', true) == false
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['claimed'])
        && request.resource.data.claimed == true;
    }
    // Список переписок (письма не-друзьям): dmi/{чей список}/c/{собеседник}
    match /dmi/{uid}/c/{oid} {
      allow read: if signed() && lg() == uid;
      allow write: if signed() && (lg() == uid || lg() == oid);
    }

    // Приглашения друзей: refs/{кто пригласил}/got/{кого пригласили}
    match /refs/{rid}/got/{nid} {
      allow read: if signed() && (lg() == rid || lg() == nid);
      allow create: if signed() && lg() == nid && nid != rid && request.resource.data.done == false;
      allow update: if signed() && (
        (lg() == nid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['done', 'doneTs'])
          && request.resource.data.done == true
          && get(/databases/$(database)/documents/saves/$(nid)).data.lvl >= 10)
        || (lg() == rid && resource.data.done == true
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['claimed'])));
    }

    // Рейды: очередь и бои на 5 воинов
    match /raidq/{b} {
      allow read, write: if signed();
    }
    match /raids/{rid} {
      allow read, create, update: if signed();
      match /a/{uid} {
        allow read: if signed();
        allow write: if signed() && lg() == uid;
      }
    }

    // Общий чат: читают и пишут все вошедшие, удаляет только админ
    match /chat/{mid} {
      allow read: if signed();
      allow create: if signed() && request.resource.data.uid == lg()
        && request.resource.data.text is string && request.resource.data.text.size() <= 200;
      allow delete: if admin();
    }
  }
}
